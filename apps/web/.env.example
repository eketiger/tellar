NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_WS_URL=http://localhost:3333

# Optional — Mixpanel only loads after the user accepts cookies.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Optional — used by the PlanGate components; the Stripe secret stays on the server.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Subdomain split (production only). When unset, middleware.ts is a no-op
# and the single host serves both console + viewer.
#   - TELLAR_CONSOLE_HOST  authenticated authoring experience (e.g. app.tellar.studio)
#   - TELLAR_VIEWER_HOST   public share viewing host        (e.g. viewer.tellar.studio)
TELLAR_CONSOLE_HOST=
TELLAR_VIEWER_HOST=
