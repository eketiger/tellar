// Tellar — Prisma schema (PlanetScale / MySQL)
// PlanetScale does not support real foreign keys, so relationMode="prisma"
// emulates them in the client — which requires an index on every FK column.
// For local development you can point DATABASE_URL at a local MySQL 8 instance
// (see docker-compose.yml) or use `pscale connect` to tunnel into a PlanetScale
// dev branch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum UserRole {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  SCALE
  ENTERPRISE
}

enum AccessMode {
  PUBLIC
  EMAIL_GATED
  PASSPHRASE
  INVITE_ONLY
}

enum EventType {
  SLIDE_VIEW
  SLIDE_DWELL
  AGENT_QUERY
  SHARE_OPEN
  DOWNLOAD
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  name                  String
  passwordHash          String?
  provider              AuthProvider   @default(EMAIL)
  providerId            String?
  avatarUrl             String?
  role                  UserRole       @default(USER)
  isSuspended           Boolean        @default(false)
  lastLoginAt           DateTime?
  // GDPR
  gdprConsentAt         DateTime?
  gdprConsentVersion    String?
  dataExportRequestedAt DateTime?
  deletionRequestedAt   DateTime?
  // Stripe
  stripeCustomerId      String?        @unique
  createdAt             DateTime       @default(now())
  memberships           Membership[]
  sessions              Session[]
  ownedWorkspaces       Workspace[]    @relation("owner")
  subscriptions         Subscription[]
  invoices              Invoice[]
  copilotUsages         CopilotUsage[]
  askUsages             AskUsage[]
  googleConnection      GoogleConnection?
}

// One Google account connection per Tellar user (unique by userId). Stores
// the refresh token we obtained during /google/auth/callback so later
// imports can run silently — the access token is short-lived and refreshed
// on demand via the refresh token.
model GoogleConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  email        String
  name         String?
  refreshToken String   @db.Text
  accessToken  String?  @db.Text
  expiresAt    DateTime?
  scope        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Workspace {
  id        String       @id @default(cuid())
  ownerId   String
  owner     User         @relation("owner", fields: [ownerId], references: [id])
  name      String
  slug      String       @unique
  plan      Plan         @default(FREE)
  seats     Int          @default(1)
  createdAt DateTime     @default(now())
  members   Membership[]
  tellers   Teller[]
  usage     Usage?
  billing   Billing?

  @@index([ownerId])
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  email       String
  role        Role      @default(EDITOR)
  status      String    @default("active")
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([userId])
}

model Teller {
  id           String      @id @default(cuid())
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id])
  ownerId      String
  title        String
  theme        String      @default("editorial-cream")
  revision     Int         @default(1)
  deletedAt    DateTime?
  vectorizedAt DateTime?
  vectorStatus String?
  isPublished  Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  slides       Slide[]
  shares       Share[]
  kbSources    KBSource[]
  recordings   Recording[]
  events       Event[]

  @@index([workspaceId, deletedAt])
  @@index([ownerId])
}

model Slide {
  id         String  @id @default(cuid())
  tellerId   String
  teller     Teller  @relation(fields: [tellerId], references: [id])
  idx        Int
  layoutId   String  @default("headline")
  background Json    @default("{}")
  eyebrow    String?
  title      String  @db.Text
  subtitle   String? @db.Text
  notes      String? @db.Text
  layout     Json    @default("{}")

  @@unique([tellerId, idx])
}

model SlideImage {
  id        String   @id @default(cuid())
  tellerId  String
  name      String
  s3Key     String
  bytes     Int?
  mime      String?
  createdAt DateTime @default(now())

  @@index([tellerId])
}

model Share {
  id             String     @id @default(cuid())
  tellerId       String
  teller         Teller     @relation(fields: [tellerId], references: [id])
  slug           String     @unique
  accessMode     AccessMode @default(EMAIL_GATED)
  // MySQL has no native string[] — store as JSON array.
  allowedDomains Json       @default("[]")
  passphraseHash String?
  perms          Json       @default("{}")
  expiresAt      DateTime?
  maxOpens       Int?
  requireOTC     Boolean    @default(false)
  revokedAt      DateTime?
  invitees       Invitee[]
  events         Event[]
  createdAt      DateTime   @default(now())

  @@index([tellerId])
}

model Invitee {
  id       String    @id @default(cuid())
  shareId  String
  share    Share     @relation(fields: [shareId], references: [id])
  email    String
  name     String?
  status   String    @default("pending")
  opens    Int       @default(0)
  lastSeen DateTime?

  @@unique([shareId, email])
}

model Recording {
  id                String   @id @default(cuid())
  tellerId          String
  teller            Teller   @relation(fields: [tellerId], references: [id])
  slideId           String?
  mode              String
  durationMs        Int
  sizeBytes         Int
  s3Key             String
  transcript        String?  @db.Text
  status            String   @default("uploading")
  createdAt         DateTime @default(now())

  // Whole-deck recordings store one s3 file referenced by many child rows.
  // Children have parentRecordingId set + startOffsetMs/endOffsetMs carving
  // out their segment of the parent. The parent is a headless row (slideId
  // = null); the viewer always streams from the parent and seeks to the
  // child's offsets.
  parentRecordingId String?
  startOffsetMs     Int      @default(0)
  endOffsetMs       Int?

  @@index([tellerId])
  @@index([slideId])
  @@index([parentRecordingId])
}

model KBSource {
  id        String    @id @default(cuid())
  tellerId  String
  teller    Teller    @relation(fields: [tellerId], references: [id])
  kind      String
  name      String
  bytes     Int?
  s3Key     String?
  indexed   Boolean   @default(false)
  chunks    KBChunk[]
  createdAt DateTime  @default(now())

  @@index([tellerId])
}

model KBChunk {
  id       String   @id @default(cuid())
  sourceId String
  source   KBSource @relation(fields: [sourceId], references: [id])
  page     Int?
  text     String   @db.Text

  @@index([sourceId])
}

model Event {
  id        String    @id @default(cuid())
  type      EventType
  tellerId  String
  teller    Teller    @relation(fields: [tellerId], references: [id])
  shareId   String?
  share     Share?    @relation(fields: [shareId], references: [id])
  sessionId String
  email     String?
  slideIdx  Int?
  dwellMs   Int?
  meta      Json      @default("{}")
  at        DateTime  @default(now())

  @@index([tellerId, at])
  @@index([shareId, sessionId])
}

model Usage {
  workspaceId      String    @id
  workspace        Workspace @relation(fields: [workspaceId], references: [id])
  month            String
  agentQueries     Int       @default(0)
  recordingMinutes Int       @default(0)
  storageMB        Int       @default(0)
}

model Billing {
  workspaceId      String    @id
  workspace        Workspace @relation(fields: [workspaceId], references: [id])
  stripeCustomerId String?
  plan             Plan      @default(FREE)
  subscriptionId   String?
  seatCount        Int       @default(1)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  stripeSubscriptionId String    @unique
  stripePriceId        String
  status               String
  plan                 String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  stripeInvoiceId String   @unique
  amountPaid      Int
  currency        String
  status          String
  invoicePdf      String?
  createdAt       DateTime @default(now())

  @@index([userId])
}

model CopilotUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  date   String
  count  Int    @default(0)

  @@unique([userId, date])
  @@index([userId])
}

model AskUsage {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  tellerId String
  date     String
  count    Int    @default(0)

  @@unique([userId, tellerId, date])
  @@index([userId])
}

model TellerAsk {
  id        String   @id @default(cuid())
  tellerId  String
  userId    String
  question  String   @db.Text
  answer    String   @db.Text
  createdAt DateTime @default(now())

  @@index([tellerId])
  @@index([userId])
}

model CookieConsent {
  id       String   @id @default(cuid())
  userId   String?
  ipHash   String?
  version  String
  accepted Boolean
  at       DateTime @default(now())

  @@index([userId])
}
