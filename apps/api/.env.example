############################
# Core — Database (PlanetScale / MySQL)
############################
# PlanetScale production URL looks like:
#   mysql://user:pass@aws.connect.psdb.cloud/tellar?sslaccept=strict
# For local dev you can run `docker compose up -d mysql` and use:
#   mysql://tellar:tellar@localhost:3306/tellar
DATABASE_URL="mysql://tellar:tellar@localhost:3306/tellar"

JWT_SECRET="change-me-in-prod-please"
SHARE_TOKEN_SECRET="change-me-in-prod-please-too"
WEB_ORIGIN="http://localhost:3000"
BACKOFFICE_ORIGIN="http://localhost:3001"
PORT=3333
API_ORIGIN="http://localhost:3333"

############################
# Backoffice (separate admin app at apps/backoffice)
# Credentials live in env — NOT in the DB. No main-app user can log in.
############################
SUPERADMIN_EMAIL="ops@tellar.studio"
SUPERADMIN_PASSWORD="change-me-too"
SUPERADMIN_SECRET="rotate-me-independently-from-jwt-secret"

############################
# OAuth (optional)
# Without these the /auth/oauth/:provider route falls back to a dev-only mock.
############################
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/oauth/google/callback"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

############################
# AI (optional) — Anthropic only.
# All chat / copilot / agent paths route exclusively through Claude.
# When unset: agent falls back to keyword search + deterministic mock answers.
############################
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""                  # default: claude-sonnet-4-20250514

############################
# Embeddings (optional) — Voyage AI is Anthropic's recommended partner.
# Without VOYAGE_API_KEY the KB retriever runs keyword-only scoring.
############################
VOYAGE_API_KEY=""
VOYAGE_EMBED_MODEL=""               # default: voyage-3

############################
# Vector DB (optional)
# Without these: knowledge-base retrieval uses a keyword fallback (no vector DB needed).
############################
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="tellers-knowledge-base"

############################
# Billing (optional)
# Without STRIPE_SECRET_KEY: checkout becomes a local no-op that just flips the plan.
############################
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_SCALE=""

############################
# Infra (optional)
############################
REDIS_URL=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

############################
# Google Slides import (optional)
# Without these, the /google/* endpoints disable themselves and the editor
# button falls back to a "configure OAuth first" nudge.
# Redirect URI must match what you register in Google Cloud Console.
############################
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3333/api/google/auth/callback"
