DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tellar?schema=public"
# For quick dev with SQLite, swap the datasource provider in schema.prisma to "sqlite"
# and use: DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-in-prod-please"
SHARE_TOKEN_SECRET="change-me-in-prod-please-too"
WEB_ORIGIN="http://localhost:3000"
PORT=3333

# Optional — when unset the agent falls back to a deterministic mock + keyword search
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional infra
REDIS_URL=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
