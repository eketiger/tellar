############################
# Core
############################
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tellar?schema=public"
# For zero-infra dev with SQLite, set provider="sqlite" in prisma/schema.prisma
# and use: DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-in-prod-please"
SHARE_TOKEN_SECRET="change-me-in-prod-please-too"
WEB_ORIGIN="http://localhost:3000"
PORT=3333
API_ORIGIN="http://localhost:3333"

############################
# OAuth (optional)
# Without these the /auth/oauth/:provider route falls back to a dev-only mock.
############################
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/oauth/google/callback"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

############################
# AI (optional)
# When unset: agent falls back to keyword search + deterministic mock answers.
############################
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

############################
# Vector DB (optional)
# Without these: knowledge-base retrieval uses the in-Postgres keyword fallback.
############################
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="tellers-knowledge-base"

############################
# Billing (optional)
# Without STRIPE_SECRET_KEY: checkout becomes a local no-op that just flips the plan.
############################
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_SCALE=""

############################
# Infra (optional)
############################
REDIS_URL=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
